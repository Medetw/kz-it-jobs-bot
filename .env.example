# ── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token-here

# Target channel/group where vacancies are published (must have bot as admin)
TARGET_CHANNEL=@your_jobs_channel

# Comma-separated Telegram user IDs that have admin commands
ADMIN_IDS=123456789,987654321

# ── Scheduler ────────────────────────────────────────────────────────────────
# How often to poll all sources (minutes)
POLL_INTERVAL_MINUTES=30

# Delay between Telegram posts to avoid flood errors (seconds)
POST_DELAY_SECONDS=2.5

# ── Storage ──────────────────────────────────────────────────────────────────
# Path to SQLite database file
DB_PATH=jobs.db

# JSON fallback path (used on network filesystems where SQLite WAL fails)
JSON_FALLBACK_PATH=jobs_fallback.json
